RESELLPORTAL_ALLOW_LIVE_ORDERS=false
# Exact QR-image hostnames returned by ResellPortal, comma-separated. No wildcards.
RESELLPORTAL_QR_ALLOWED_HOSTS=panel.resellportal.com
ADMIN_EMAIL=
# Generate each independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
