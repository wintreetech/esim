# Database and website (use the public HTTPS website URL on Netlify).
DATABASE_URL=
DIRECT_DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Customer account sign-in; legacy anon keys remain supported if already in use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# PAYMENTS_ENABLED is the main yes/no switch. Keep no until setup is complete.
PAYMENT_PROVIDER=transactworld
PAYMENTS_ENABLED=no
TW_ENVIRONMENT=sandbox
MEMBER_ID=
WORKING_KEY=
# Supply these only if required by your TransactWorld merchant account.
TW_MERCHANT_USERNAME=
TW_PARTNER_ID=
# List only currencies approved on this merchant account. Leave empty until confirmed.
TW_SUPPORTED_CURRENCIES=
# Customer installation emails; use a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=Roamly <hello@your-verified-domain.com>
# eSIM fulfillment. Live sales require test mode no and live orders yes.
RESELLPORTAL_API_KEY=
RESELLPORTAL_API_SECRET=
# Normal reseller credentials are also used for API test mode; no separate sandbox keys.
RESELLPORTAL_TEST_MODE=yes
# Set both mode switches explicitly only when wallet-funded fulfillment should go live.
RESELLPORTAL_ALLOW_LIVE_ORDERS=no
# Exact QR-image hostnames returned by ResellPortal, comma-separated. No wildcards.
RESELLPORTAL_QR_ALLOWED_HOSTS=panel.resellportal.com
# Generate each independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_ACCESS_SECRET=
CRON_SECRET=
# Pricing: fixed amounts are in USD cents. Currency conversion needs no API key.
MARKUP_PERCENT=40
FIXED_MARKUP_CENTS=50
MIN_MARGIN_CENTS=100
TAX_PERCENT=0
